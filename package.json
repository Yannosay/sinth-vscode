{
    "name": "sinth-vscode",
    "displayName": "Sinth Code Lang Highlighting",
    "description": "Syntax highlighting for faster coding with Sinth",
    "icon": "icon.png",
    "version": "0.0.3",
    "publisher": "YannosayProductions",
    "author": "Yannosay Productions",
    "license": "AGPL-3.0",
    "engines": {
        "vscode": "^1.80.0"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/Yannosay/sinth-vscode"
    },
    "categories": [
        "Programming Languages"
    ],
    "keywords": [
        "sinth",
        "syntax highlighting",
        "language support"
    ],
    "contributes": {
        "languages": [
            {
                "id": "sinth",
                "extensions": [
                    ".sinth"
                ],
                "aliases": [
                    "Sinth"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "sinth",
                "scopeName": "source.sinth",
                "path": "./syntaxes/sinth.tmLanguage.json"
            }
        ]
    },
    "scripts": {
        "test": "echo \"Error: no test specified\" && exit 1"
    }
}